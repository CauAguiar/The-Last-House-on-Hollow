MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2030873876}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4190f8ee75b202149baeeffc70777a48, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  botoesDoMenu:
  - {fileID: 546046371}
  - {fileID: 1081550322}
  iconeAbobora: {fileID: 1404883119}
  introPanel: {fileID: 1337115963}
  introText: {fileID: 1766233660}
  introFullText: "<align=\"center\"><size=120%><b>A \xDALTIMA CASA</b></size></align>\r\n\r\nEra
    noite de Halloween na <color=#5140cr>Rua Hollow</color>. A sorte n\xE3o estava
    a favor de Charlie, e seu balde de doces estava quase vazio. As portas n\xE3o
    se abriam para ele.\n\nAt\xE9 que ele chegou na \xFAltima casa da Rua Rollow.\r\n\r\nUm
    casebre bonito, estilo g\xF3tico vitoriano. Mas que caia aos peda\xE7os. Ele
    bateu. A porta se abriu, e de dentro se ouvia o crepitar e a luz aconchegante
    de uma lareira. Mas ningu\xE9m a vista. \r\n\r\n<b>Ele n\xE3o era doido de entrar
    assim do nada.</b>\r\n\r\nMas, ao dar meia volta, um trov\xE3o rompeu os c\xE9us
    e o mundo come\xE7ou a desabar em chuva, n\xE3o restando outra escolha para ele,
    a n\xE3o ser entrar..\r\n\r\nAssim que pisou na soleira, a porta se fechou com
    um estrondo junto com um trov\xE3o que rasgava os c\xE9us. Ele est\xE1  preso,
    e agora precisa desesperadamente encontrar uma forma de sair.\n\n<color=#5140cr>Clique
    para continuar...</color>"
  charDelay: 0.03
  panelFadeIn: 1
  panelFadeOut: 1
